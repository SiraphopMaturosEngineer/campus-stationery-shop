<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Campus Stationery Startup Presentation Deck</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&family=Poppins:wght@400;500;600;700&display=swap');
        body {
            font-family: 'Kanit', 'Poppins', sans-serif;
        }
        .slide-aspect {
            aspect-ratio: 16 / 9;
        }
        .highlight-grammar {
            background-color: #fef08a;
            color: #854d0e;
            padding: 2px 6px;
            border-radius: 4px;
            font-weight: 600;
        }
        .highlight-vocab {
            background-color: #bbf7d0;
            color: #166534;
            padding: 2px 6px;
            border-radius: 4px;
            font-weight: 600;
        }
        .highlight-phrase {
            background-color: #e0e7ff;
            color: #3730a3;
            padding: 2px 6px;
            border-radius: 4px;
            font-weight: 600;
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 min-h-screen">

