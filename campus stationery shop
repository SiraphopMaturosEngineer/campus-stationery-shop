                        <button onclick="enhanceScriptWithAI('simplified')" class="bg-white hover:bg-purple-100 text-purple-800 border border-purple-200 text-xs py-2 px-3 rounded-lg font-medium transition">
                            💡 Simple & Easy Clear
                        </button>
                        <button onclick="resetScriptToOriginal()" class="bg-slate-200 hover:bg-slate-300 text-slate-700 text-xs py-2 px-3 rounded-lg font-medium transition">
