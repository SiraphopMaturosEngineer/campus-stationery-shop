                            <i class="fa-solid fa-wand-magic-sparkles"></i>
                            <span>AI ปรับแต่งสคริปต์</span>
                        </button>

                        <button onclick="copyScriptText()" class="text-xs text-indigo-600 hover:text-indigo-800 font-medium flex items-center space-x-1 border border-indigo-200 hover:border-indigo-400 px-3 py-1.5 rounded-lg transition">
