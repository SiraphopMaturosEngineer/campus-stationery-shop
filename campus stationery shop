                    <div class="grid grid-cols-2 md:grid-cols-4 gap-2">
                        <button onclick="enhanceScriptWithAI('energetic')" class="bg-white hover:bg-purple-100 text-purple-800 border border-purple-200 text-xs py-2 px-3 rounded-lg font-medium transition">
