    <!-- Q&A Practice Simulator Modal -->
    <div id="qaModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm hidden z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-2xl w-full p-6 space-y-4 shadow-2xl border border-slate-200 relative max-h-[90vh] overflow-y-auto">
            <button onclick="toggleQAModal()" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 text-lg">
                <i class="fa-solid fa-xmark"></i>
            </button>

            <div class="flex items-center space-x-3 text-indigo-700 border-b border-slate-100 pb-3">
                <i class="fa-solid fa-graduation-cap text-2xl text-yellow-500"></i>
                <div>
                    <h3 class="font-bold text-lg">AI Pitch Practice & Q&A Coach</h3>
                    <p class="text-xs text-slate-500">ฝึกตอบคำถามสดกับ AI กรรมการประเมินผล</p>
                </div>
            </div>

            <div class="space-y-4">
                <!-- Question Box -->
                <div class="bg-indigo-50 border border-indigo-200 p-4 rounded-xl space-y-2">
                    <div class="flex items-center justify-between text-xs font-bold text-indigo-800">
                        <span>❓ คำถามสุ่มจากกรรมการ (Q&A Question):</span>
                        <button onclick="generateQAQuestion()" class="text-indigo-600 hover:text-indigo-800 flex items-center space-x-1">
                            <i class="fa-solid fa-rotate"></i>
                            <span>สุ่มคำถามใหม่</span>
                        </button>
                    </div>
                    <div id="qaQuestionBox" class="text-sm font-semibold text-indigo-950">
                        กดปุ่มเพื่อเริ่มสร้างคำถาม Q&A จากเนื้อหาสไลด์ปัจจุบัน...
                    </div>
                </div>

                <!-- User Answer Input -->
                <div class="space-y-1.5">
                    <label class="block text-xs font-bold text-slate-700">พิมพ์คำตอบของคุณ (ภาษาอังกฤษ):</label>
                    <textarea id="qaUserAnswer" rows="3" class="w-full p-3 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="e.g., We plan to use TikTok videos and student reward cards to attract buyers..."></textarea>
                </div>

                <button id="qaSubmitBtn" onclick="submitQAAnswer()" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2.5 rounded-xl text-sm flex items-center justify-center space-x-2 transition shadow">
                    <i class="fa-solid fa-paper-plane"></i>
                    <span>ส่งคำตอบให้ AI ช่วยตรวจ & ให้คำแนะนำ</span>
                </button>

                <!-- Feedback Result Box -->
                <div id="qaFeedbackBox" class="hidden bg-slate-50 border border-slate-200 p-4 rounded-xl text-xs space-y-2 leading-relaxed">
                    <!-- Dynamic feedback content -->
                </div>
            </div>
        </div>
    </div>

    <script>
        // API Configuration setup
        const getApiKey = () => ""; // Canvas will provide key at runtime

        // Audio Player state
        let currentAudioSource = null;

        // Base 7 Speakers presentation scripts storage
        let originalScripts = [];

        // Convert PCM 16-bit Base64 Audio to Web Audio API Playback
        async function playPcm16Audio(base64Data, sampleRate = 24000) {
            try {
                if (currentAudioSource) {
                    currentAudioSource.stop();
                }

                const binary = atob(base64Data);
                const len = binary.length;
                const bytes = new Uint8Array(len);
                for (let i = 0; i < len; i++) {
                    bytes[i] = binary.charCodeAt(i);
                }
                const pcm16 = new Int16Array(bytes.buffer);
                
                const audioCtx = new (window.AudioContext || window.webkitAudioContext)({ sampleRate });
                const buffer = audioCtx.createBuffer(1, pcm16.length, sampleRate);
                const channelData = buffer.getChannelData(0);
                
                for (let i = 0; i < pcm16.length; i++) {
                    channelData[i] = pcm16[i] / 32768.0;
                }
                
                const source = audioCtx.createBufferSource();
                source.buffer = buffer;
                source.connect(audioCtx.destination);
                source.start(0);
                currentAudioSource = source;
                
                source.onended = () => {
                    resetTTSButtonState();
                };
            } catch (err) {
                console.error("Audio playback error:", err);
                resetTTSButtonState();
            }
        }

        function resetTTSButtonState() {
            const btn = document.getElementById('ttsPlayBtn');
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = `<i class="fa-solid fa-play"></i><span>ฟังเสียง AI อ่าน (TTS)</span>`;
            }
        }

        async function speakScriptTTS() {
            const btn = document.getElementById('ttsPlayBtn');
            const data = presentationData[currentSlideIndex];
            const voice = document.getElementById('ttsVoiceSelect').value;

            // Strip HTML highlight tags for TTS text
            const tempDiv = document.createElement("div");
            tempDiv.innerHTML = data.script;
            const cleanText = tempDiv.textContent || tempDiv.innerText;

            btn.disabled = true;
            btn.innerHTML = `<i class="fa-solid fa-circle-notch fa-spin"></i><span>กำลังสร้างเสียง...</span>`;

            try {
                const apiKey = getApiKey();
                const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-tts:generateContent?key=${apiKey}`;

                const payload = {
                    contents: [{
                        parts: [{ text: `Say clearly: ${cleanText}` }]
                    }],
                    generationConfig: {
                        responseModalities: ["AUDIO"],
                        speechConfig: {
                            voiceConfig: {
                                prebuiltVoiceConfig: { voiceName: voice }
                            }
                        }
                    }
                };

                const response = await fetch(apiUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();
                const part = result?.candidates?.[0]?.content?.parts?.[0];
                const audioData = part?.inlineData?.data;
                const mimeType = part?.inlineData?.mimeType || "";

                if (audioData) {
                    let sampleRate = 24000;
                    const match = mimeType.match(/rate=(\d+)/);
                    if (match) {
                        sampleRate = parseInt(match[1], 10);
                    }
                    btn.innerHTML = `<i class="fa-solid fa-volume-high fa-beat"></i><span>กำลังเล่นเสียง...</span>`;
                    playPcm16Audio(audioData, sampleRate);
                } else {
                    alert("ไม่สามารถสร้างเสียงได้ในขณะนี้ กรุณาลองใหม่อีกครั้ง");
                    resetTTSButtonState();
                }
            } catch (err) {
                console.error("TTS fetch failed:", err);
                alert("เกิดข้อผิดพลาดในการเชื่อมต่อกับ Gemini TTS");
                resetTTSButtonState();
            }
        }

        async function generateSlideImage() {
            const data = presentationData[currentSlideIndex];
            const slideFrame = document.getElementById('slideFrame');
            const aiBadge = document.getElementById('aiImageBadge');

            const originalContent = slideFrame.innerHTML;
            const prompt = `A clean modern aesthetic 3D illustration banner for presentation: ${data.title}, ${data.subtitle}, cute stationery, minimal clean background, vibrant pastel colors, high resolution, 16:9 wallpaper concept.`;

            // UI loading overlay
            aiBadge.classList.remove('hidden');
            aiBadge.innerHTML = `<i class="fa-solid fa-circle-notch fa-spin mr-1"></i> กำลังเจนรูปด้วย Gemini AI...`;

            try {
                const apiKey = getApiKey();
                const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-image:generateContent?key=${apiKey}`;

                const payload = {
                    contents: [{
                        role: 'user',
                        parts: [{ text: prompt }]
                    }],
                    generationConfig: {
                        responseModalities: ['IMAGE'],
                        imageConfig: { aspectRatio: "16:9" }
                    }
                };

                const response = await fetch(apiUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();
                const part = result?.candidates?.[0]?.content?.parts?.find(p => p.inlineData);

                if (part && part.inlineData) {
                    const imageUrl = `data:${part.inlineData.mimeType};base64,${part.inlineData.data}`;
                    slideFrame.style.backgroundImage = `url('${imageUrl}')`;
                    aiBadge.innerHTML = `✨ Gemini AI Artwork`;
                } else {
                    alert("ไม่สามารถสร้างรูปภาพได้ กรุณาลองใหม่อีกครั้ง");
                    aiBadge.classList.add('hidden');
                }
            } catch (err) {
                console.error("Image gen error:", err);
                alert("เกิดข้อผิดพลาดในการเชื่อมต่อกับ Gemini Image API");
                aiBadge.classList.add('hidden');
            }
        }

        function toggleRewriteOptions() {
            const drawer = document.getElementById('rewriteOptionsDrawer');
            drawer.classList.toggle('hidden');
        }

        async function enhanceScriptWithAI(style) {
            const scriptBox = document.getElementById('scriptContent');
            const data = presentationData[currentSlideIndex];
            
            scriptBox.innerHTML = `
                <div class="flex items-center space-x-2 text-purple-600 font-medium py-4">
                    <i class="fa-solid fa-wand-magic-sparkles fa-spin text-lg"></i>
                    <span>Gemini กำลังเรียบเรียงสคริปต์สไตล์ ${style} ใหม่ให้คุณ...</span>
                </div>
            `;

            try {
                const apiKey = getApiKey();
                const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

                const systemPrompt = `You are a professional presentation coach. Rephrase the speaker's English presentation script to be ${style}. Keep it concise (approx 3-4 sentences). 
                IMPORTANT: Wrap grammar structures in <span class="highlight-grammar">...</span>, target vocabulary in <span class="highlight-vocab">...</span>, and presentation phrases in <span class="highlight-phrase">...</span>. Keep HTML tags intact in output.`;

                const userQuery = `Current Script: "${data.script}"\nRephrase in ${style} tone. Return ONLY the HTML formatted text script.`;

                const payload = {
                    contents: [{ parts: [{ text: userQuery }] }],
                    systemInstruction: { parts: [{ text: systemPrompt }] }
                };

                const response = await fetch(apiUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();
                const generatedText = result?.candidates?.[0]?.content?.parts?.[0]?.text;

                if (generatedText) {
                    presentationData[currentSlideIndex].script = generatedText;
                    scriptBox.innerHTML = generatedText;
                } else {
                    resetScriptToOriginal();
                }
            } catch (err) {
                console.error("Script rewrite error:", err);
                resetScriptToOriginal();
            }
        }

        function resetScriptToOriginal() {
            if (originalScripts[currentSlideIndex]) {
                presentationData[currentSlideIndex].script = originalScripts[currentSlideIndex];
                document.getElementById('scriptContent').innerHTML = originalScripts[currentSlideIndex];
            }
        }

        function toggleQAModal() {
            const modal = document.getElementById('qaModal');
            modal.classList.toggle('hidden');
            if (!modal.classList.contains('hidden')) {
                generateQAQuestion();
            }
        }

        function openQAModal() {
            toggleQAModal();
        }

        async function generateQAQuestion() {
            const questionBox = document.getElementById('qaQuestionBox');
            const data = presentationData[currentSlideIndex];
            
            questionBox.innerHTML = `<i class="fa-solid fa-circle-notch fa-spin mr-2"></i>Gemini กำลังคิดคำถามสำหรับสไลด์ "${data.title}"...`;
            document.getElementById('qaFeedbackBox').classList.add('hidden');

            try {
                const apiKey = getApiKey();
                const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

                const userPrompt = `Generate 1 realistic, challenging Q&A question that a judge or teacher would ask after listening to this presentation slide:
                Topic: ${data.title}
                Bullet points: ${data.bullets.join(", ")}
                Return ONLY the question in clear English.`;

                const payload = {
                    contents: [{ parts: [{ text: userPrompt }] }]
                };

                const response = await fetch(apiUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();
                const text = result?.candidates?.[0]?.content?.parts?.[0]?.text;
                questionBox.innerText = text || "What makes your campus stationery shop different from traditional bookstores?";
            } catch (err) {
                questionBox.innerText = "What is your main marketing strategy to reach university students?";
            }
        }

        async function submitQAAnswer() {
            const answerInput = document.getElementById('qaUserAnswer');
            const questionText = document.getElementById('qaQuestionBox').innerText;
            const feedbackBox = document.getElementById('qaFeedbackBox');
            const submitBtn = document.getElementById('qaSubmitBtn');

            if (!answerInput.value.trim()) {
                alert("กรุณาพิมพ์คำตอบก่อนส่งตรวจครับ");
                return;
            }

            submitBtn.disabled = true;
            submitBtn.innerHTML = `<i class="fa-solid fa-circle-notch fa-spin"></i><span>กำลังวิเคราะห์คำตอบ...</span>`;

            try {
                const apiKey = getApiKey();
                const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

                const prompt = `Evaluate the student's response to this Q&A pitch question:
                Question: "${questionText}"
                Student Answer: "${answerInput.value.trim()}"
                
                Provide feedback in Thai in 3 bullet points:
                1. 🌟 ข้อดีของคำตอบ
                2. ✏️ คำแนะนำเพิ่มเติมหรือการปรับปรุงภาษาอังกฤษ
                3. 💡 ตัวอย่างคำตอบระดับเกียรตินิยม (Sample Answer)`;

                const payload = { contents: [{ parts: [{ text: prompt }] }] };

                const response = await fetch(apiUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();
                const text = result?.candidates?.[0]?.content?.parts?.[0]?.text;

                feedbackBox.innerHTML = `<div class="font-bold text-slate-800 mb-1">ผลการประเมินจาก Gemini AI Coach:</div>${text.replace(/\n/g, '<br>')}`;
                feedbackBox.classList.remove('hidden');
            } catch (err) {
                alert("เกิดข้อผิดพลาดในการประเมินคำตอบ");
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerHTML = `<i class="fa-solid fa-paper-plane"></i><span>ส่งคำตอบให้ AI ช่วยตรวจ & ให้คำแนะนำ</span>`;
            }
        }

        // Initialize original scripts backup on load
        window.addEventListener('load', () => {
            originalScripts = presentationData.map(item => item.script);
        });
    </script>
</body>
</html>
